###BASE
SERVICE_NAME=account
APP_ENV=local
LOG_LEVEL=debug

###GRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50053

###DB
DB_DSN=host=localhost port=5433 user=postgres password=postgres dbname=account_db sslmode=disable

KAFKA_BROKER_HOST=localhost:29092
KAFKA_CONSUMER_GROUP=consumer-account
KAFKA_PUBLISH_TOPIC=account_responses
KAFKA_SUBSCRIBE_TOPIC=transaction_requests