# Go microservices Makefile (Windows / cmd.exe)
# Нужны: GNU make, git, docker, PowerShell (есть в Windows из коробки)

SHELL := cmd.exe

SERVICES := $(notdir $(patsubst %/main.go,%,$(wildcard cmd/*/main.go)))

BIN_DIR    ?= bin
CONFIG_DIR ?= configs
VERSION    ?= $(shell git describe --tags --always --dirty 2>NUL || echo dev)
BUILD_TIME ?= $(shell powershell -NoProfile -Command "(Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')")
LDFLAGS    ?= -ldflags "-X main.Version=$(VERSION) -X main.BuildTime=$(BUILD_TIME)"

# cmd.exe не понимает "/" в пути к исполняемому файлу
BIN_DIR_WIN = $(subst /,\,$(BIN_DIR))

# Go-файлы для форматирования (сгенерированный protobuf-код не трогаем).
# Это PowerShell-выражение: список собирается внутри powershell, чтобы не упереться в лимит длины строки cmd.exe
GOFILES_PS ?= Get-ChildItem -Recurse -File -Filter *.go \
	| Where-Object { $$_.FullName -notmatch '\\(vendor|\.git)\\' -and $$_.Name -notmatch '\.pb(\.gw)?\.go$$' } \
	| ForEach-Object { $$_.FullName }

# все сервисы из docker-compose.yml с суффиксом -db (auth-db, account-db, ...)
DB_SERVICES := $(shell docker compose config --services 2>NUL | findstr /E /C:"-db")


# env-файл для локального запуска: configs/<svc>.local.env, если есть, иначе configs/<svc>.env
env_file = $(if $(wildcard $(CONFIG_DIR)/$(1).local.env),$(CONFIG_DIR)/$(1).local.env,$(CONFIG_DIR)/$(1).env)

BUILD_TARGETS    := $(addprefix build-,$(SERVICES))
RUN_TARGETS      := $(addprefix run-,$(SERVICES))
RUN_ONLY_TARGETS := $(addprefix run-only-,$(SERVICES))

.DEFAULT_GOAL := build

# ---------- Сборка и запуск ----------

## services         - показать найденные сервисы
services:
	@echo $(SERVICES)

## build            - собрать все сервисы
build: $(BUILD_TARGETS)

## build-<svc>      - собрать один сервис (make build-auth)
$(BUILD_TARGETS): build-%:
	@echo Building $*...
	@if not exist $(BIN_DIR_WIN) mkdir $(BIN_DIR_WIN)
	go build $(LDFLAGS) -o $(BIN_DIR)/$*.exe ./cmd/$*

## run-<svc>        - собрать и запустить сервис локально (make run-account)
$(RUN_TARGETS): run-%: build-%
	@echo Running $* with $(call env_file,$*)...
	set "ENV_FILE=$(call env_file,$*)" && $(BIN_DIR_WIN)\$*.exe

## run-only-<svc>   - запустить без пересборки
$(RUN_ONLY_TARGETS): run-only-%:
	@echo Running $* with $(call env_file,$*)...
	set "ENV_FILE=$(call env_file,$*)" && $(BIN_DIR_WIN)\$*.exe

## run-all          - запустить все сервисы локально параллельно (Ctrl+C остановит все)
run-all:
	$(MAKE) -j$(words $(SERVICES)) $(RUN_TARGETS)

# ---------- Docker ----------

## up               - поднять всё в docker compose (с пересборкой образов)
up:
	docker compose up -d --build

## down             - остановить контейнеры
down:
	docker compose down

## down-v           - остановить и удалить тома (БД пересоздастся, init.sql выполнится заново)
down-v:
	docker compose down -v

## logs             - логи (все или одного: make logs s=auth)
logs:
	docker compose logs -f $(s)

## ps               - статус контейнеров
ps:
	docker compose ps

# ---------- Контракты ----------

## proto            - сгенерировать Go-код из .proto (через contracts/Makefile)
proto:
	$(MAKE) -C contracts

# ---------- Зависимости ----------

## deps             - скачать зависимости
deps:
	@echo Installing dependencies...
	go mod download
	go mod tidy

## deps-update      - обновить зависимости
deps-update:
	@echo Updating dependencies...
	go get -u ./...
	go mod tidy

# ---------- Качество кода ----------

## fmt              - форматирование
fmt:
	@echo Formatting code...
	powershell -NoProfile -Command "$$f = @($(GOFILES_PS)); if ($$f.Count) { goimports -w $$f; gofumpt -w $$f }"

## lint             - линтер
lint:
	@echo Running linter...
	golangci-lint run --timeout=10m ./...

## test             - тесты
test:
	@echo Running tests...
	go test -v ./...

## test-coverage    - тесты с отчётом покрытия
test-coverage:
	@echo Running tests with coverage...
	go test -coverprofile=coverage.out ./...
	go tool cover -html=coverage.out -o coverage.html
	@echo Coverage report generated: coverage.html

## bench            - бенчмарки
bench:
	go test -bench=. ./...

## clean            - удалить артефакты сборки
clean:
	@echo Cleaning build artifacts...
	@if exist $(BIN_DIR_WIN) rmdir /s /q $(BIN_DIR_WIN)
	@if exist coverage.out del /f /q coverage.out
	@if exist coverage.html del /f /q coverage.html

## docs             - godoc на :6060
docs:
	godoc -http=:6060

# ---------- Workflows ----------

## db-up            - поднять БД всех сервисов и дождаться healthcheck
db-up:
	docker compose up -d --wait $(DB_SERVICES)

## db-down          - остановить БД (данные сохраняются)
db-down:
	docker compose stop $(DB_SERVICES)


## dev              - fmt + lint + test + build
dev: fmt lint test build

## ci               - deps + lint + test + build
ci: deps lint test build

## help             - эта справка
help:
	@echo Targets (services: $(SERVICES)):
	@powershell -NoProfile -Command "Get-Content -Encoding UTF8 '$(firstword $(MAKEFILE_LIST))' | Where-Object { $$_ -like '## *' } | ForEach-Object { '  ' + $$_.Substring(3) }"

.PHONY: services build run-all up down down-v logs ps proto deps deps-update \
	fmt lint test test-coverage bench clean docs db-up db-down dev ci help \
	$(BUILD_TARGETS) $(RUN_TARGETS) $(RUN_ONLY_TARGETS)