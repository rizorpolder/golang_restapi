#account
###BASE
SERVICE_NAME=account
APP_ENV=local
LOG_LEVEL=debug

###GRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50053

###DB
DB_DSN=host=localhost port=5433 user=postgres password=postgres dbname=account_db sslmode=disable

#auth
###BASE
SERVICE_NAME=auth
APP_ENV=local
LOG_LEVEL=debug

###GRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

###DB
DB_DSN=host=localhost port=5432 user=postgres password=postgres dbname=auth_db sslmode=disable

###JWT
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

#gateway
###BASE
SERVICE_NAME=gateway
APP_ENV=local
LOG_LEVEL=debug

###GRPC (сервер gateway, в него проксирует grpc-gateway)
GRPC_HOST=0.0.0.0
GRPC_PORT=50050

###HTTP (вход для клиентов)
HTTP_HOST=0.0.0.0
HTTP_PORT=9000

###SERVICES
AUTH_ADDR=localhost:50052
ACCOUNT_ADDR=localhost:50053

#postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

#transaction
###BASE
SERVICE_NAME=transaction
APP_ENV=local
LOG_LEVEL=debug

###GRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50054

###DB
DB_DSN=postgres://postgres:postgres@localhost:5434/transaction?sslmode=disabled

ACCOUNT_GRPC_HOST=localhost:50053
