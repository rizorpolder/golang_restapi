# Go microservices Makefile (macOS / Linux)

SERVICES := $(notdir $(patsubst %/main.go,%,$(wildcard cmd/*/main.go)))

BIN_DIR    ?= bin
CONFIG_DIR ?= configs
VERSION    ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
BUILD_TIME ?= $(shell date -u '+%Y-%m-%dT%H:%M:%SZ')
LDFLAGS    ?= -ldflags "-X main.Version=$(VERSION) -X main.BuildTime=$(BUILD_TIME)"

# Go-файлы для форматирования (сгенерированный protobuf-код не трогаем)
GOFILES ?= $(shell find . -name "*.go" -type f \
	-not -path "./vendor/*" -not -path "./.git/*" \
	-not -name "*.pb.go" -not -name "*.pb.gw.go")

# env-файл для локального запуска: configs/<svc>.local.env, если есть, иначе configs/<svc>.env
env_file = $(if $(wildcard $(CONFIG_DIR)/$(1).local.env),$(CONFIG_DIR)/$(1).local.env,$(CONFIG_DIR)/$(1).env)

BUILD_TARGETS    := $(addprefix build-,$(SERVICES))
RUN_TARGETS      := $(addprefix run-,$(SERVICES))
RUN_ONLY_TARGETS := $(addprefix run-only-,$(SERVICES))

.DEFAULT_GOAL := build

# ---------- Сборка и запуск ----------

## services         - показать найденные сервисы
services:
	@echo $(SERVICES)

## build            - собрать все сервисы
build: $(BUILD_TARGETS)

## build-<svc>      - собрать один сервис (make build-auth)
$(BUILD_TARGETS): build-%:
	@echo "Building $*..."
	@mkdir -p $(BIN_DIR)
	go build $(LDFLAGS) -o $(BIN_DIR)/$* ./cmd/$*

## run-<svc>        - собрать и запустить сервис локально (make run-account)
$(RUN_TARGETS): run-%: build-%
	@echo "Running $* with $(call env_file,$*)..."
	ENV_FILE=$(call env_file,$*) ./$(BIN_DIR)/$*

## run-only-<svc>   - запустить без пересборки
$(RUN_ONLY_TARGETS): run-only-%:
	@echo "Running $* with $(call env_file,$*)..."
	ENV_FILE=$(call env_file,$*) ./$(BIN_DIR)/$*

## run-all          - запустить все сервисы локально параллельно (Ctrl+C остановит все)
run-all:
	$(MAKE) -j$(words $(SERVICES)) $(RUN_TARGETS)

# ---------- Docker ----------

## up               - поднять всё в docker compose (с пересборкой образов)
up:
	docker compose up -d --build

## down             - остановить контейнеры
down:
	docker compose down

## down-v           - остановить и удалить тома (БД пересоздастся, init.sql выполнится заново)
down-v:
	docker compose down -v

## logs             - логи (все или одного: make logs s=auth)
logs:
	docker compose logs -f $(s)

## ps               - статус контейнеров
ps:
	docker compose ps

# ---------- Контракты ----------

## proto            - сгенерировать Go-код из .proto (через contracts/Makefile)
proto:
	$(MAKE) -C contracts

# ---------- Зависимости ----------

## deps             - скачать зависимости
deps:
	@echo "Installing dependencies..."
	go mod download
	go mod tidy

## deps-update      - обновить зависимости
deps-update:
	@echo "Updating dependencies..."
	go get -u ./...
	go mod tidy

# ---------- Качество кода ----------

## fmt              - форматирование
fmt:
	@echo "Formatting code..."
	goimports -w $(GOFILES)
	gofumpt -w $(GOFILES)

## lint             - линтер
lint:
	@echo "Running linter..."
	golangci-lint run --timeout=10m ./...

## test             - тесты
test:
	@echo "Running tests..."
	go test -v ./...

## test-coverage    - тесты с отчётом покрытия
test-coverage:
	@echo "Running tests with coverage..."
	go test -coverprofile=coverage.out ./...
	go tool cover -html=coverage.out -o coverage.html
	@echo "Coverage report generated: coverage.html"

## bench            - бенчмарки
bench:
	go test -bench=. ./...

## clean            - удалить артефакты сборки
clean:
	@echo "Cleaning build artifacts..."
	rm -rf $(BIN_DIR)/
	rm -f coverage.out coverage.html

## docs             - godoc на :6060
docs:
	godoc -http=:6060

# ---------- Workflows ----------

## dev              - fmt + lint + test + build
dev: fmt lint test build

## ci               - deps + lint + test + build
ci: deps lint test build

## help             - эта справка
help:
	@echo "Targets (services: $(SERVICES)):"
	@grep -E '^## ' $(MAKEFILE_LIST) | sed 's/^## /  /'

.PHONY: services build run-all up down down-v logs ps proto deps deps-update \
	fmt lint test test-coverage bench clean docs dev ci help \
	$(BUILD_TARGETS) $(RUN_TARGETS) $(RUN_ONLY_TARGETS)